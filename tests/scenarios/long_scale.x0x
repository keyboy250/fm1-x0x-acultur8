# Native controls for a 32-bar block, key/scale and per-303 adherence.
wait 300
tap HOME
tap HOME
tapkey w0
tapkey w1
turn K1 -2
turn SELECT 2
turn K2 1
turn SELECT -1
turn K4 31
wait 100
expect blockbars1 32
shot block_32_bars.png
tap SEL
turn SELECT 18
turn ALGO 3
wait 100
expect follow0 3
shot scale_adherence_menu.png
turn SELECT -1
turn ALGO 5
turn SELECT -1
turn ALGO 2
wait 100
expect hkey 2
expect hscale 5
shot scale_key_menu.png
tap HOME
tap SAVE
wait 200
reboot
expect blockbars1 32
expect follow0 3
expect hkey 2
expect hscale 5
